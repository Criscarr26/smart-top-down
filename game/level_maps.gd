static func by_name(map_name: String) -> LevelData:
	match map_name:
		"level_01": return LevelData.from_ascii("level_01", LEVEL_01)
		"level_02": return LevelData.from_ascii("level_02", LEVEL_02)
		"level_03": return LevelData.from_ascii("level_03", LEVEL_03)
		"validation": return LevelData.from_ascii("validation", LEVEL_VALIDATION)
	push_error("LevelMaps: nivel desconocido '%s'" % map_name)
	return LevelData.from_ascii("level_01", LEVEL_01)


## Niveles permitidos durante el entrenamiento (excluye el de validacion).
static func training_levels() -> Array:
	return ["level_01", "level_02", "level_03"]
